# Copy to ~/.config/agent-skills.env (or store as an Ona file secret; see README.md).
# Never commit the filled-in copy.

# Slack member ID (Slack profile > ⋮ > Copy member ID).
SLACK_USER_ID=U0000000000

# Main work repository and its local checkout.
WORK_GITHUB_REPO=my-org/my-repo
WORK_REPO_DIR=/workspaces/my-repo

# GitHub team I review for, used by pr-review-tabs to scope each review.
REVIEW_TEAM=@my-org/my-team

# Comma-separated team slugs to ignore as requested reviewers in check-in.
IGNORED_REVIEW_TEAMS=

# Glean MCP endpoint, the fallback for Slack, Drive and Gmail in agents without those connectors.
GLEAN_MCP_URL=https://<company>-be.glean.com/mcp/default

# Claude Doc that check-in keeps: one tab per day, plus a Handled tab for items I've ticked off.
CHECKIN_DOC_URL=https://claude.ai/artifact/<id>
